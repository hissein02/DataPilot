# Copy this file to .env at the repository root.
# Choose openai or ollama for the question feature.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANALYSIS_MODEL=gpt-6-luna
# For Ollama, set LLM_PROVIDER=ollama and OLLAMA_MODEL to a local model tag.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TIMEOUT_SECONDS=120

# Optional local limits. Remove a line to use the default in backend/app/core/config.py.
MAX_UPLOAD_MB=25
WORKSPACE_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:5173
MAX_ROWS=200000
MAX_COLUMNS=200
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=2
MAX_QUERY_ROWS=100
MAX_QUERY_SECONDS=10
MAX_RESULT_BYTES=100000
MAX_SQL_RETRIES=3
MAX_SQL_QUERIES=5

# By default, workspaces use the system temporary directory.
# WORKSPACE_ROOT=/path/to/local/workspaces
